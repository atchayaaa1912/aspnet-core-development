@model List<Web1.Models.ContactMessage>

@{
    ViewData["Title"] = "Contact Messages";
}

<div class="messages-page">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Contact Messages</h2>
            <p class="text-muted mb-0">
                View and manage customer enquiries.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="ExportToExcel"
           class="btn btn-success export-btn">
            <i class="bi bi-file-earmark-excel"></i>
            Export to Excel
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 messages-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Subject</th>
                            <th>Message</th>
                            <th>Submitted At</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var message in Model)
                        {
                            <tr>
                                <td>@message.Id</td>
                                <td class="fw-semibold">@message.FullName</td>
                                <td>@message.Email</td>
                                <td>@message.Subject</td>
                                <td>@message.Message</td>
                                <td>
                                    @message.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                </td>

                                <td>
                                    <div class="action-buttons">

                                        <a asp-action="Details"
                                           asp-route-id="@message.Id"
                                           class="action-btn action-view"
                                           title="View"
                                           aria-label="View contact message">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@message.Id"
                                           class="action-btn action-edit"
                                           title="Edit"
                                           aria-label="Edit contact message">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@message.Id"
                                           class="action-btn action-delete"
                                           title="Delete"
                                           aria-label="Delete contact message">
                                            <i class="bi bi-trash"></i>
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }

                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                    No contact messages available.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>
